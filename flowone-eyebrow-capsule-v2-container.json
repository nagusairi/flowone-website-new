        "_css_classes": "fo-hero-eyebrow-container-native is-static",
        "custom_css": "selector {\n  user-select: none;\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  cursor: default !important;\n}\nselector:hover {\n  transform: none !important;\n}\nselector .fo-chip-spark i, selector .fo-chip-spark svg {\n  animation: foSparkRotate 4s linear infinite;\n}\n@keyframes foSparkRotate {\n  0% { transform: scale(1) rotate(0deg); }\n  50% { transform: scale(1.18) rotate(180deg); }\n  100% { transform: scale(1) rotate(360deg); }\n}"
      },
